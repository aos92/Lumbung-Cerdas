# fruit-nvidia-api: contoh konfigurasi. Salin ke .env (berkas .env diabaikan git).
# Variabel yang sudah ada di environment selalu menang atas isi berkas ini.

# ── Wajib ──
# Key dari https://build.nvidia.com/settings/api-keys (berawalan nvapi-)
NVIDIA_API_KEY=
# Kunci bersama ESP32 <-> backend. Nilai yang sama dengan API_KEY di sketch.
# Wajib bila HOST bukan loopback (mis. di Render).
SHARED_SECRET=

# ── Opsional (nilai di bawah = bawaan kode) ──
# Model vision dengan Free Endpoint di build.nvidia.com
# NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Batas waktu menunggu NVIDIA (ms)
# FRUIT_TIMEOUT_MS=30000
# Batas ukuran foto (byte)
# MAX_IMAGE_BYTES=3145728
# Pembacaan sensor tersimpan dipakai untuk foto yang dikirim tanpa sensor, selama umurnya kurang dari ini (detik)
# SENSOR_MAX_AGE_S=600
# Analisis tren: pengamatan lebih tua dari ini (jam) diabaikan; rentang minimum (menit) sebelum tren dinilai
# TREND_WINDOW_H=72
# TREND_MIN_SPAN_MIN=10
# Lokal: 127.0.0.1. Render: 0.0.0.0 (sudah diatur di render.yaml; PORT diisi Render otomatis).
# Termux di HP yang hotspot-nya dipakai ESP32: HOST=0.0.0.0 (wajib, bersama SHARED_SECRET). Lihat docs/TERMUX.md.
# HOST=127.0.0.1
# PORT=9655
# Catat tiap request ke konsol (1 = ya, 0 = mati). Berguna untuk melihat ESP32 menghubungi server.
# LOG_REQUESTS=1
